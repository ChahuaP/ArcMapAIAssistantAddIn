{
  "pack": "data_management",
  "operations": [
    {
      "id": "data.copy_features",
      "version": "1.0",
      "category": "data_management",
      "summary": "复制图层要素为新的要素类或 Shapefile。",
      "keywords": [
        "copy features",
        "复制要素",
        "另存为",
        "导出要素"
      ],
      "parameters_schema": {
        "type": "object",
        "required": [
          "input_layer",
          "output_name"
        ],
        "properties": {
          "input_layer": {
            "type": "string",
            "x-geopilot-kind": "layer"
          },
          "output_name": {
            "type": "string"
          },
          "output_workspace": {
            "type": "string"
          },
          "output_folder": {
            "type": "string"
          },
          "output_format": {
            "type": "string",
            "enum": [
              "gdb",
              "shp"
            ]
          }
        },
        "additionalProperties": false
      },
      "context_requirements": {
        "requires_layers": true,
        "requires_output_location_when_unsaved": true
      },
      "side_effects": "writes_data",
      "output_policy": {
        "writes_output": true,
        "type": "feature_class",
        "formats": [
          "gdb",
          "shp"
        ],
        "default_format": "gdb",
        "workspace": "mxd_default_or_output_workspace_or_output_folder",
        "overwrite": false,
        "add_to_map": true
      },
      "executor": "operations.data_management_ops.copy_features",
      "examples": [
        {
          "user": "把 roads 复制成一个新的 shp",
          "arguments": {
            "input_layer": "roads",
            "output_name": "roads_copy",
            "output_format": "shp"
          }
        }
      ],
      "capability_contract": {
        "inputs": [
          {
            "parameter": "input_layer",
            "cardinality": "one",
            "data_kind": [
              "feature_layer",
              "raster_layer",
              "table_view"
            ],
            "geometry": [
              "point",
              "polyline",
              "polygon",
              "raster",
              "not_applicable"
            ],
            "required_fields": [],
            "selection": {"rule": "any"}
          }
        ],
        "parameters_schema": {
          "type": "object",
          "required": [
            "input_layer",
            "output_name"
          ],
          "properties": {
            "input_layer": {
              "type": "string",
              "x-geopilot-kind": "layer"
            },
            "output_name": {
              "type": "string"
            },
            "output_workspace": {
              "type": "string"
            },
            "output_folder": {
              "type": "string"
            },
            "output_format": {
              "type": "string",
              "enum": [
                "gdb",
                "shp"
              ]
            }
          },
          "additionalProperties": false
        },
        "outputs": {
          "kind": "feature_class",
          "geometry": {
            "rule": "inherit",
            "value": "input_layer"
          },
          "fields": {
            "effect": "inherit_input",
            "target": "input_layer",
            "static_fields": [],
            "parameter_field": "not_applicable"
          },
          "spatial_reference": {
            "rule": "inherit",
            "input": "input_layer"
          },
          "cardinality": {
            "rule": "fixed",
            "value": "one_or_more_per_input_feature"
          },
          "selection_state": "not_applicable",
          "map_publication": "published"
        },
        "side_effects": "writes_data",
        "authorization": {
          "required": true,
          "scope": "write_data"
        },
        "postconditions": [
          {
            "kind": "feature_class_created",
            "target": "output_name",
            "expectation": {
              "kind": {
                "ref": "outputs.kind"
              },
              "geometry": {
                "ref": "outputs.geometry"
              },
              "fields": {
                "ref": "outputs.fields"
              },
              "spatial_reference": {
                "ref": "outputs.spatial_reference"
              },
              "cardinality": {
                "ref": "outputs.cardinality"
              },
              "selection_state": {
                "ref": "outputs.selection_state"
              },
              "map_publication": {
                "ref": "outputs.map_publication"
              }
            }
          }
        ],
        "semantic_effects": [
          {
            "kind": "copy",
            "source": {
              "parameter": "input_layer"
            },
            "result": {
              "output": true
            }
          }
        ]
      }
    },

      },
      "context_requirements": {"requires_layers": true, "requires_saved_mxd": true},
      "side_effects": "writes_data",
      "output_policy": {"writes_output": true, "workspace": "ArcMapAI_Output", "overwrite": false},
      "executor": "operations.export_ops.export_table_csv",
      "examples": [{"user": "导出 roads 属性表为 csv", "arguments": {"layer": "roads", "output_name": "roads_table", "selected_only": false}}]

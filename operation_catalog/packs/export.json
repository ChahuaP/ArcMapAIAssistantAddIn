    {
      "id": "export.table_csv",
      "version": "1.0",
      "category": "export",
      "summary": "导出图层属性表为 CSV。",
      "keywords": ["export csv", "导出表", "导出属性表", "CSV"],
      "model_card": "Use export.table_csv to export a layer table to CSV. Arguments: layer, output_name, selected_only optional.",

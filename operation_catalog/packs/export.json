  "operations": [
    {
      "id": "export.map_png",
      "version": "1.0",
      "category": "export",
      "summary": "导出当前地图为 PNG。",
      "keywords": ["export png", "导出图片", "PNG"],
      "model_card": "Use export.map_png to export current map to PNG. Arguments: output_name, resolution optional.",
      "parameters_schema": {
        "type": "object",
        "required": ["output_name"],
        "properties": {"output_name": {"type": "string"}, "resolution": {"type": "integer"}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_saved_mxd": true},
      "side_effects": "writes_data",
      "output_policy": {"writes_output": true, "workspace": "ArcMapAI_Output", "overwrite": false},
      "executor": "operations.export_ops.export_map_png",
      "examples": [{"user": "导出当前地图为 png", "arguments": {"output_name": "current_map", "resolution": 150}}]
    },
    {
      "id": "export.map_pdf",
      "version": "1.0",
      "category": "export",
      "summary": "导出当前地图为 PDF。",
      "keywords": ["export pdf", "导出PDF", "PDF"],
      "model_card": "Use export.map_pdf to export current map to PDF. Arguments: output_name, resolution optional.",
      "parameters_schema": {
        "type": "object",
        "required": ["output_name"],
        "properties": {"output_name": {"type": "string"}, "resolution": {"type": "integer"}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_saved_mxd": true},
      "side_effects": "writes_data",
      "output_policy": {"writes_output": true, "workspace": "ArcMapAI_Output", "overwrite": false},
      "executor": "operations.export_ops.export_map_pdf",
      "examples": [{"user": "导出当前地图为 pdf", "arguments": {"output_name": "current_map_pdf", "resolution": 150}}]

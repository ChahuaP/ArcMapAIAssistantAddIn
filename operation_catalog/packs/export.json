{
  "pack": "export",
  "version": "0.1.0",
  "operations": [
    {
      "id": "export.map_png",
      "version": "1.0",
      "category": "export",
      "summary": "导出当前地图为 PNG。",
      "keywords": ["export png", "导出图片", "PNG"],
      "model_card": "Use export.map_png to export current map to PNG. Arguments: output_name, resolution optional, output_folder optional when MXD is unsaved.",
      "parameters_schema": {
        "type": "object",
        "required": ["output_name"],
        "properties": {"output_name": {"type": "string"}, "resolution": {"type": "integer"}, "output_folder": {"type": "string"}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_output_location_when_unsaved": true},
      "side_effects": "writes_data",
      "output_policy": {"writes_output": true, "workspace": "mxd_default_or_output_folder", "overwrite": false},
      "executor": "operations.export_ops.export_map_png",
      "examples": [{"user": "导出当前地图为 png", "arguments": {"output_name": "current_map", "resolution": 150}}]
    },
    {
      "id": "export.map_pdf",
      "version": "1.0",
      "category": "export",
      "summary": "导出当前地图为 PDF。",
      "keywords": ["export pdf", "导出PDF", "PDF"],
      "model_card": "Use export.map_pdf to export current map to PDF. Arguments: output_name, resolution optional, output_folder optional when MXD is unsaved.",
      "parameters_schema": {
        "type": "object",
        "required": ["output_name"],
        "properties": {"output_name": {"type": "string"}, "resolution": {"type": "integer"}, "output_folder": {"type": "string"}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_output_location_when_unsaved": true},
      "side_effects": "writes_data",
      "output_policy": {"writes_output": true, "workspace": "mxd_default_or_output_folder", "overwrite": false},
      "executor": "operations.export_ops.export_map_pdf",
      "examples": [{"user": "导出当前地图为 pdf", "arguments": {"output_name": "current_map_pdf", "resolution": 150}}]
    },
    {
      "id": "export.table_csv",
      "version": "1.0",
      "category": "export",
      "summary": "导出图层属性表为 CSV。",
      "keywords": ["export csv", "导出表", "导出属性表", "CSV"],
      "model_card": "Use export.table_csv to export a layer table to CSV. Arguments: layer, output_name, selected_only optional, output_folder optional when MXD is unsaved.",
      "parameters_schema": {
        "type": "object",
        "required": ["layer", "output_name"],
        "properties": {"layer": {"type": "string"}, "output_name": {"type": "string"}, "selected_only": {"type": "boolean"}, "output_folder": {"type": "string"}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true, "requires_output_location_when_unsaved": true},
      "side_effects": "writes_data",
      "output_policy": {"writes_output": true, "workspace": "mxd_default_or_output_folder", "overwrite": false},
      "executor": "operations.export_ops.export_table_csv",
      "examples": [{"user": "导出 roads 属性表为 csv", "arguments": {"layer": "roads", "output_name": "roads_table", "selected_only": false}}]
    },
    {
      "id": "export.split_by_field",
      "version": "1.0",
      "category": "export",
      "summary": "按字段唯一值把一个图层拆分导出为多个数据文件。",
      "keywords": ["split by field", "按字段拆分", "按属性分组导出", "每类导出shp"],
      "model_card": "Use export.split_by_field to export one output per unique value of a field. Arguments: layer, field, output_name as ASCII prefix, output_format optional shp|gdb, output_folder for shapefiles, output_workspace for gdb, include_null optional, selected_only optional, max_outputs optional. Use this when the user asks to split/export features by a field value.",
      "parameters_schema": {
        "type": "object",
        "required": ["layer", "field", "output_name"],
        "properties": {
          "layer": {"type": "string"},
          "field": {"type": "string"},
          "output_name": {"type": "string"},
          "output_format": {"type": "string", "enum": ["shp", "gdb"]},
          "output_folder": {"type": "string"},
          "output_workspace": {"type": "string"},
          "include_null": {"type": "boolean"},
          "selected_only": {"type": "boolean"},
          "max_outputs": {"type": "integer"}
        },
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true, "requires_fields": true, "field_arguments": ["field"], "requires_output_location_when_unsaved": true},
      "side_effects": "writes_data",
      "output_policy": {"writes_output": true, "workspace": "mxd_default_or_output_folder_or_output_workspace", "overwrite": false},
      "executor": "operations.export_ops.split_by_field",
      "examples": [{"user": "把 roads 按 type 字段拆分导出为 shp", "arguments": {"layer": "roads", "field": "type", "output_name": "roads_by_type", "output_format": "shp", "output_folder": "D:\\Data\\exports"}}]
    }
  ]
}

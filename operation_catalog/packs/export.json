{
  "pack": "export",
  "operations": [
    {
      "id": "export.map_png",
      "version": "1.0",
      "category": "export",
      "summary": "导出当前地图为 PNG。",
      "keywords": [
        "export png",
        "导出图片",
        "PNG"
      ],
      "model_card": "Use export.map_png to export current map to PNG. Arguments: output_name, resolution optional, output_folder optional when MXD is unsaved.",
      "parameters_schema": {
        "type": "object",
        "required": [
          "output_name"
        ],
        "properties": {
          "output_name": {
            "type": "string"
          },
          "resolution": {
            "type": "integer"
          },
          "output_folder": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "context_requirements": {
        "requires_output_location_when_unsaved": true
      },
      "side_effects": "writes_data",
      "output_policy": {
        "writes_output": true,
        "type": "file",
        "extension": ".png",
        "workspace": "mxd_default_or_output_folder",
        "overwrite": false,
        "add_to_map": false
      },
      "executor": "operations.export_ops.export_map_png",
      "examples": [
        {
          "user": "导出当前地图为 png",
          "arguments": {
            "output_name": "current_map",
            "resolution": 150
          }
        }
      ]
    },

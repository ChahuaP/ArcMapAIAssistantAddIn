{
  "pack": "selection",
  "version": "0.1.0",
  "operations": [
    {
      "id": "selection.select_by_attribute",
      "version": "1.0",
      "category": "selection",
      "summary": "按属性条件选择要素。",
      "keywords": ["select", "where", "选择", "属性选择", "大于", "小于", "等于"],
      "model_card": "Use selection.select_by_attribute to select features by SQL where clause. Arguments: layer, where_clause, selection_type optional.",
      "parameters_schema": {
        "type": "object",
        "required": ["layer", "where_clause"],
        "properties": {
          "layer": {"type": "string"},
          "where_clause": {"type": "string"},
          "selection_type": {"type": "string", "enum": ["NEW_SELECTION", "ADD_TO_SELECTION", "REMOVE_FROM_SELECTION", "SUBSET_SELECTION", "SWITCH_SELECTION", "CLEAR_SELECTION"]}
        },
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true, "requires_fields": true},
      "side_effects": "changes_map",
      "output_policy": {"writes_output": false},
      "executor": "operations.selection_ops.select_by_attribute",
      "examples": [{"user": "选择人口大于10000的县", "arguments": {"layer": "counties", "where_clause": "POPULATION > 10000"}}]
    },
    {
      "id": "selection.select_by_location",
      "version": "1.0",
      "category": "selection",
      "summary": "按空间关系选择要素。",
      "keywords": ["select by location", "空间选择", "相交", "within", "intersect"],
      "model_card": "Use selection.select_by_location to select target features by spatial relation to another layer. Arguments: target_layer, overlap_type, select_layer.",
      "parameters_schema": {
        "type": "object",
        "required": ["target_layer", "overlap_type", "select_layer"],
        "properties": {
          "target_layer": {"type": "string"},
          "overlap_type": {"type": "string"},
          "select_layer": {"type": "string"},
          "selection_type": {"type": "string"}
        },
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true},
      "side_effects": "changes_map",
      "output_policy": {"writes_output": false},
      "executor": "operations.selection_ops.select_by_location",
      "examples": [{"user": "选择和 rivers 相交的 parcels", "arguments": {"target_layer": "parcels", "overlap_type": "INTERSECT", "select_layer": "rivers"}}]
    },
    {
      "id": "selection.clear_selection",
      "version": "1.0",
      "category": "selection",
      "summary": "清除图层选择。",
      "keywords": ["clear selection", "清除选择", "取消选择"],
      "model_card": "Use selection.clear_selection to clear selected features on one layer. Arguments: layer.",
      "parameters_schema": {
        "type": "object",
        "required": ["layer"],
        "properties": {"layer": {"type": "string"}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true},
      "side_effects": "changes_map",
      "output_policy": {"writes_output": false},
      "executor": "operations.selection_ops.clear_selection",
      "examples": [{"user": "清除 roads 选择", "arguments": {"layer": "roads"}}]
    },
    {
      "id": "selection.export_selected_features",
      "version": "1.0",
      "category": "selection",
      "summary": "导出图层当前已选要素为新要素类。",
      "keywords": ["export selected", "导出选择", "导出选中"],
      "model_card": "Use selection.export_selected_features to export selected features to ArcMapAI_Output.gdb. Arguments: layer, output_name.",
      "parameters_schema": {
        "type": "object",
        "required": ["layer", "output_name"],
        "properties": {"layer": {"type": "string"}, "output_name": {"type": "string"}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true, "requires_saved_mxd": true},
      "side_effects": "writes_data",
      "output_policy": {"writes_output": true, "workspace": "ArcMapAI_Output.gdb", "overwrite": false},
      "executor": "operations.selection_ops.export_selected_features",
      "examples": [{"user": "导出 roads 选中的要素", "arguments": {"layer": "roads", "output_name": "roads_selected"}}]
    }
  ]
}

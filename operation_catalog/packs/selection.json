{
  "pack": "selection",
  "operations": [
    {
      "id": "selection.select_by_attribute",
      "version": "1.0",
      "category": "selection",
      "summary": "按属性条件选择要素。",
      "keywords": [
        "select",
        "where",
        "选择",
        "属性选择",
        "大于",
        "小于",
        "等于",
        "之间",
        "为空",
        "包含"
      ],
      "parameters_schema": {
        "type": "object",
        "required": [
          "layer",
          "where"
        ],
        "properties": {
          "layer": {
            "type": "string"
          },
          "where": {
            "type": "object"
          },
          "selection_type": {
            "type": "string",
            "default": "NEW_SELECTION",
            "enum": [
              "NEW_SELECTION",
              "ADD_TO_SELECTION",
              "REMOVE_FROM_SELECTION",
              "SUBSET_SELECTION",
              "SWITCH_SELECTION",
              "CLEAR_SELECTION"
            ]
          }
        },
        "additionalProperties": false
      },
      "context_requirements": {
        "requires_layers": true,
        "requires_fields": true,
        "condition_fields": true
      },
      "side_effects": "changes_map",
      "output_policy": {
        "writes_output": false
      },
      "executor": "operations.selection_ops.select_by_attribute",
      "examples": [
        {
          "user": "选择人口大于10000的县",
          "arguments": {
            "layer": "counties",
            "where": {
              "field": "POPULATION",
              "op": "gt",
              "value": 10000
            }
          }
        }
      ],
      "capability_contract": {
        "inputs": [
          {
            "parameter": "layer",
            "cardinality": "one",
            "data_kind": [
              "feature_layer"
            ],
            "geometry": [
              "point",
              "polyline",
              "polygon"
            ],
            "required_fields": [],
            "selection": {"rule": "parameter_values_require_selected", "parameter": "selection_type", "values": ["REMOVE_FROM_SELECTION", "SUBSET_SELECTION"]}
          }
        ],
        "parameters_schema": {
          "type": "object",
          "required": [
            "layer",
            "where"
          ],
          "properties": {
            "layer": {
              "type": "string"
            },
            "where": {
              "type": "object"
            },
            "selection_type": {
              "type": "string",
              "default": "NEW_SELECTION",
              "enum": [
                "NEW_SELECTION",
                "ADD_TO_SELECTION",
                "REMOVE_FROM_SELECTION",
                "SUBSET_SELECTION",
                "SWITCH_SELECTION",
                "CLEAR_SELECTION"
              ]
            }
          },
          "additionalProperties": false
        },
        "outputs": {
          "kind": "map_state",
          "geometry": {
            "rule": "not_applicable",
            "value": "not_applicable"
          },
          "fields": {
            "effect": "not_applicable",
            "target": "not_applicable",
            "static_fields": [],
            "parameter_field": "not_applicable"
          },
          "spatial_reference": {
            "rule": "not_applicable",
            "input": "not_applicable"
          },
          "cardinality": {
            "rule": "fixed",
            "value": "one_snapshot"
          },
          "selection_state": "applied",
          "map_publication": "map_state_updated"
        },
        "side_effects": "changes_map",
        "authorization": {
          "required": true,
          "scope": "modify_map"
        },
        "postconditions": [
          {
            "kind": "selection_count_matches_result",
            "target": "map",
            "expectation": {
              "kind": {
                "ref": "outputs.kind"
              },
              "geometry": {
                "ref": "outputs.geometry"
              },
              "fields": {
                "ref": "outputs.fields"
              },
              "spatial_reference": {
                "ref": "outputs.spatial_reference"
              },
              "cardinality": {
                "ref": "outputs.cardinality"
              },
              "selection_state": {
                "ref": "outputs.selection_state"
              },
              "map_publication": {
                "ref": "outputs.map_publication"
              }
            }
          }
        ],
        "semantic_effects": [
          {
            "kind": "attribute_filter",
            "target": {
              "parameter": "layer"
            },
            "where": {
              "parameter": "where"
            },
            "selection_type": {
              "parameter": "selection_type"
            },
            "result": {
              "output": true
            }
          }
        ]
      }
    },
    {

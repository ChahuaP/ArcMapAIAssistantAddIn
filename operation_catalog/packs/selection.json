    {
      "id": "selection.export_selected_features",
      "version": "1.0",
      "category": "selection",
      "summary": "导出图层当前已选要素为新要素类。",
      "keywords": [
        "export selected",
        "导出选择",
        "导出选中"
      ],
      "parameters_schema": {
        "type": "object",
        "required": [
          "layer",
          "output_name"
        ],
        "properties": {
          "layer": {
            "type": "string"
          },
          "output_name": {
            "type": "string"
          },
          "output_workspace": {
            "type": "string"
          },
          "output_folder": {
            "type": "string"
          },
          "output_format": {
            "type": "string",
            "default": "gdb",
            "enum": [
              "gdb",
              "shp"
            ]
          }
        },
        "additionalProperties": false
      },
      "context_requirements": {
        "requires_layers": true,
        "requires_output_location_when_unsaved": true
      },
      "side_effects": "writes_data",
      "output_policy": {
        "writes_output": true,
        "type": "feature_class",
        "formats": [
          "gdb",
          "shp"
        ],
        "default_format": "gdb",
        "workspace": "mxd_default_or_output_workspace_or_output_folder",
        "overwrite": false,
        "add_to_map": true
      },
      "executor": "operations.selection_ops.export_selected_features",
      "examples": [
        {
          "user": "导出 roads 选中的要素",
          "arguments": {
            "layer": "roads",
            "output_name": "roads_selected"
          }
        }
      ],
      "capability_contract": {
        "inputs": [
          {
            "parameter": "layer",
            "cardinality": "one",
            "data_kind": [
              "feature_layer"
            ],
            "geometry": [
              "point",
              "polyline",
              "polygon"
            ],
            "required_fields": [],
            "selection": {"rule": "requires_selected"}
          }
        ],
        "parameters_schema": {
          "type": "object",
          "required": [
            "layer",
            "output_name"
          ],
          "properties": {
            "layer": {
              "type": "string"
            },
            "output_name": {
              "type": "string"
            },
            "output_workspace": {
              "type": "string"
            },
            "output_folder": {
              "type": "string"
            },
            "output_format": {
              "type": "string",
              "default": "gdb",
              "enum": [
                "gdb",
                "shp"
              ]
            }
          },
          "additionalProperties": false
        },
        "outputs": {
          "kind": "feature_class",
          "geometry": {
            "rule": "inherit",
            "value": "layer"
          },
          "fields": {
            "effect": "inherit_input",
            "target": "layer",
            "static_fields": [],
            "parameter_field": "not_applicable"
          },
          "spatial_reference": {
            "rule": "inherit",
            "input": "layer"
          },
          "cardinality": {
            "rule": "fixed",
            "value": "selected_feature_count"
          },
          "selection_state": "not_applicable",
          "map_publication": "published"
        },
        "side_effects": "writes_data",
        "authorization": {
          "required": true,
          "scope": "write_data"
        },
        "postconditions": [
          {
            "kind": "selected_features_exported",
            "target": "output_name",
            "expectation": {
              "kind": {
                "ref": "outputs.kind"
              },
              "geometry": {
                "ref": "outputs.geometry"
              },
              "fields": {
                "ref": "outputs.fields"
              },
              "spatial_reference": {
                "ref": "outputs.spatial_reference"
              },
              "cardinality": {
                "ref": "outputs.cardinality"
              },
              "selection_state": {
                "ref": "outputs.selection_state"
              },
              "map_publication": {
                "ref": "outputs.map_publication"
              }
            }
          }
        ],
        "semantic_effects": [
          {
            "kind": "artifact_export",
            "target": {
              "parameter": "layer"
            },
            "selected_only": {
              "const": true
            },
            "output_format": {
              "parameter": "output_format"
            },
            "result": {
              "output": true
            },
            "action": {
              "const": "export_selected_features"
            }
          }
        ]
      }
    }
  ]
}

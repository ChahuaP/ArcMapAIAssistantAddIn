          },
          "spatial_reference": {
            "rule": "not_applicable",
            "input": "not_applicable"
          },
          "cardinality": {
            "rule": "fixed",
            "value": "one_snapshot"
          },
          "selection_state": "applied",
          "map_publication": "map_state_updated"
        },
        "side_effects": "changes_map",
        "authorization": {
          "required": true,
          "scope": "modify_map"
        },
        "postconditions": [

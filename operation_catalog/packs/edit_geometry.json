    {
      "id": "edit.create_polygon_feature",
      "version": "1.0",
      "category": "edit_geometry",
      "summary": "根据坐标环创建新的面要素图层，可一次写入多个面。",
      "keywords": ["create polygon", "创建面", "多边形", "面要素"],
      "model_card": "Use edit.create_polygon_feature to create one new polygon feature class. For one polygon, pass coordinates and optional name. For multiple polygons in the same output layer, pass features array items with coordinates and optional name. Do not create one shapefile per polygon unless the user explicitly asks for separate layers. The runtime closes each ring if the last point is not equal to the first point.",
      "parameters_schema": {
        "type": "object",
        "required": ["output_name"],
        "properties": {
          "coordinates": {
            "type": "array",
            "items": {"type": "object"},
            "minItems": 3
          },
          "features": {
            "type": "array",
            "items": {"type": "object"},
            "minItems": 1
          },
          "output_name": {"type": "string"},
          "name": {"type": "string"},
          "spatial_reference_layer": {"type": "string", "x-geopilot-kind": "layer"},
          "wkid": {"type": "integer"},
          "output_workspace": {"type": "string"},
          "output_folder": {"type": "string"},
          "output_format": {"type": "string", "enum": ["gdb", "shp"]}
        },
        "additionalProperties": false
      },
      "context_requirements": {
        "requires_layers": false,
        "requires_output_location_when_unsaved": true
      },
      "side_effects": "writes_data",
      "output_policy": {
        "writes_output": true,
        "type": "feature_class",
        "geometry_type": "Polygon",
        "formats": ["gdb", "shp"],
        "default_format": "gdb",
        "workspace": "mxd_default_or_output_workspace_or_output_folder",
        "overwrite": false,
        "add_to_map": true
      },
      "executor": "operations.edit_geometry_ops.create_polygon_feature",
      "examples": [
        {
          "user": "用四个角点创建一个面",
          "arguments": {
            "coordinates": [{"x": 0, "y": 0}, {"x": 10, "y": 0}, {"x": 10, "y": 10}, {"x": 0, "y": 10}],
            "output_name": "polygon_from_ring"
          }
        },
        {
          "user": "把两个地块创建到同一个图层",
          "arguments": {
            "features": [
              {"name": "parcel_1", "coordinates": [{"x": 0, "y": 0}, {"x": 10, "y": 0}, {"x": 10, "y": 10}, {"x": 0, "y": 10}]},
              {"name": "parcel_2", "coordinates": [{"x": 20, "y": 0}, {"x": 30, "y": 0}, {"x": 30, "y": 10}, {"x": 20, "y": 10}]}
            ],
            "output_name": "parcels"
          }
        }
      ]
    },

{
  "pack": "edit_geometry",
  "operations": [
    {
      "id": "edit.create_point_features",
      "version": "1.0",
      "category": "edit_geometry",
      "summary": "根据坐标创建新的点要素图层，可一次写入多个点。",
      "keywords": ["create point", "创建点", "坐标点", "点要素"],
      "model_card": "Use edit.create_point_features to create one new point feature class from explicit coordinates. Put all requested point features in the points array; do not create one shapefile per point unless the user explicitly asks for separate layers. Arguments: points array of {x,y,name optional}, output_name, spatial_reference_layer optional, wkid optional, output_workspace/output_folder/output_format optional. If spatial_reference_layer and wkid are omitted, ArcMap uses the active data frame spatial reference and fails when it is unknown.",
      "parameters_schema": {
        "type": "object",
        "required": ["points", "output_name"],
        "properties": {
          "points": {
            "type": "array",
            "items": {"type": "object"},
            "minItems": 1
          },
          "output_name": {"type": "string"},
          "spatial_reference_layer": {"type": "string", "x-geopilot-kind": "layer"},
          "wkid": {"type": "integer"},
          "output_workspace": {"type": "string"},
          "output_folder": {"type": "string"},
          "output_format": {"type": "string", "enum": ["gdb", "shp"]}
        },
        "additionalProperties": false
      },
      "context_requirements": {
        "requires_layers": false,
        "requires_output_location_when_unsaved": true
      },
      "side_effects": "writes_data",
      "output_policy": {
        "writes_output": true,
        "type": "feature_class",
        "geometry_type": "Point",
        "formats": ["gdb", "shp"],
        "default_format": "gdb",
        "workspace": "mxd_default_or_output_workspace_or_output_folder",
        "overwrite": false,
        "add_to_map": true
      },
      "executor": "operations.edit_geometry_ops.create_point_features",
      "examples": [
        {
          "user": "在 118.78,32.04 创建一个点",
          "arguments": {
            "points": [{"x": 118.78, "y": 32.04, "name": "point_1"}],
            "wkid": 4326,
            "output_name": "point_1"
          }
        }
      ]
    },
    {
      "id": "edit.append_point_features",
      "version": "1.0",
      "category": "edit_geometry",
      "summary": "向已有点图层追加点要素。",
      "keywords": ["append point", "添加点", "追加点", "已有图层"],
      "model_card": "Use edit.append_point_features only when the user wants to add point features into an existing point layer, such as 往某图层里继续创建点. This directly edits the target dataset and requires edit authorization. Arguments: target_layer, points array of {x,y,name optional}. Do not use this for creating a new output layer.",
      "parameters_schema": {
        "type": "object",
        "required": ["target_layer", "points"],
        "properties": {
          "target_layer": {"type": "string", "x-geopilot-kind": "layer"},
          "points": {
            "type": "array",
            "items": {"type": "object"},
            "minItems": 1
          }
        },
        "additionalProperties": false
      },
      "context_requirements": {
        "requires_layers": true
      },
      "side_effects": "edits_data",
      "output_policy": {
        "writes_output": false,
        "edits_target_layer": true,
        "geometry_type": "Point"
      },
      "executor": "operations.edit_geometry_ops.append_point_features",
      "examples": [
        {
          "user": "往 points 图层里添加两个点",
          "arguments": {
            "target_layer": "points",
            "points": [{"x": 118.78, "y": 32.04, "name": "A"}, {"x": 118.79, "y": 32.05, "name": "B"}]
          }
        }
      ]
    },
    {
      "id": "edit.create_polyline_feature",
      "version": "1.0",
      "category": "edit_geometry",
      "summary": "根据坐标序列创建新的线要素图层，可一次写入多条线。",
      "keywords": ["create line", "创建线", "折线", "线要素"],
      "model_card": "Use edit.create_polyline_feature to create one new polyline feature class. For one line, pass coordinates and optional name. For multiple lines in the same output layer, pass features array items with coordinates and optional name. Do not create one shapefile per line unless the user explicitly asks for separate layers. Arguments: coordinates or features, output_name, spatial_reference_layer optional, wkid optional, output location optional.",
      "parameters_schema": {
        "type": "object",
        "required": ["output_name"],
        "properties": {
          "coordinates": {
            "type": "array",
            "items": {"type": "object"},
            "minItems": 2
          },
          "features": {
            "type": "array",
            "items": {"type": "object"},
            "minItems": 1
          },
          "output_name": {"type": "string"},
          "name": {"type": "string"},
          "spatial_reference_layer": {"type": "string", "x-geopilot-kind": "layer"},
          "wkid": {"type": "integer"},
          "output_workspace": {"type": "string"},
          "output_folder": {"type": "string"},
          "output_format": {"type": "string", "enum": ["gdb", "shp"]}
        },
        "additionalProperties": false
      },
      "context_requirements": {
        "requires_layers": false,
        "requires_output_location_when_unsaved": true
      },
      "side_effects": "writes_data",
      "output_policy": {
        "writes_output": true,
        "type": "feature_class",
        "geometry_type": "Polyline",
        "formats": ["gdb", "shp"],
        "default_format": "gdb",
        "workspace": "mxd_default_or_output_workspace_or_output_folder",
        "overwrite": false,
        "add_to_map": true
      },
      "executor": "operations.edit_geometry_ops.create_polyline_feature",
      "examples": [
        {
          "user": "用这些坐标创建一条线",
          "arguments": {
            "coordinates": [{"x": 0, "y": 0}, {"x": 10, "y": 10}],
            "output_name": "line_from_points"
          }
        },
        {
          "user": "把两条道路线创建到同一个 shp",
          "arguments": {
            "features": [
              {"name": "road_1", "coordinates": [{"x": 0, "y": 0}, {"x": 10, "y": 10}]},
              {"name": "road_2", "coordinates": [{"x": 0, "y": 1}, {"x": 10, "y": 11}]}
            ],
            "output_name": "roads"
          }
        }
      ]
    },

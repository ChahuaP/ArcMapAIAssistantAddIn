    {
      "id": "edit.create_regular_polygon",
      "version": "1.0",
      "category": "edit_geometry",
      "summary": "按中心点、半径和边数创建新的正多边形图层，可一次写入多个面。",
      "keywords": ["regular polygon", "正多边形", "五边形", "六边形"],
      "model_card": "Use edit.create_regular_polygon to create one new polygon feature class containing regular polygon features. For one polygon, pass center_x, center_y, radius, radius_unit, sides, and output_name. For multiple regular polygons in the same output layer, pass features array items with center_x, center_y, radius, radius_unit, sides, optional name; shared values such as radius_unit or sides may stay at top level. Do not create one shapefile per polygon unless the user explicitly asks for separate layers. radius_unit must be map_units, meters, or degrees.",
      "parameters_schema": {
        "type": "object",
        "required": ["output_name"],
        "properties": {
          "center_x": {"type": "number"},
          "center_y": {"type": "number"},
          "radius": {"type": "number"},
          "radius_unit": {"type": "string", "enum": ["map_units", "meters", "degrees"]},
          "sides": {"type": "integer"},
          "start_angle_degrees": {"type": "number"},
          "features": {
            "type": "array",
            "items": {"type": "object"},
            "minItems": 1
          },
          "name": {"type": "string"},
          "output_name": {"type": "string"},
          "spatial_reference_layer": {"type": "string", "x-geopilot-kind": "layer"},
          "wkid": {"type": "integer"},
          "output_workspace": {"type": "string"},
          "output_folder": {"type": "string"},
          "output_format": {"type": "string", "enum": ["gdb", "shp"]}
        },
        "additionalProperties": false
      },
      "context_requirements": {
        "requires_layers": false,
        "requires_output_location_when_unsaved": true
      },
      "side_effects": "writes_data",
      "output_policy": {
        "writes_output": true,
        "type": "feature_class",
        "geometry_type": "Polygon",
        "formats": ["gdb", "shp"],
        "default_format": "gdb",
        "workspace": "mxd_default_or_output_workspace_or_output_folder",
        "overwrite": false,
        "add_to_map": true
      },
      "executor": "operations.edit_geometry_ops.create_regular_polygon",
      "examples": [
        {
          "user": "在当前地图中心附近创建一个半径 100 米的正五边形",
          "arguments": {
            "center_x": 500000,
            "center_y": 3500000,
            "radius": 100,
            "radius_unit": "meters",
            "sides": 5,
            "output_name": "regular_pentagon"
          }
        },
        {
          "user": "创建三个正五边形到同一个图层",
          "arguments": {
            "features": [
              {"center_x": 500000, "center_y": 3500000, "name": "pentagon_1"},
              {"center_x": 501000, "center_y": 3500000, "name": "pentagon_2"},
              {"center_x": 502000, "center_y": 3500000, "name": "pentagon_3"}
            ],
            "radius": 100,
            "radius_unit": "meters",
            "sides": 5,
            "output_name": "pentagons"
          }
        }
      ]
    },
    {
      "id": "edit.append_regular_polygons",

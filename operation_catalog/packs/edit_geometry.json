        "required": ["output_name"],
        "properties": {
          "center_x": {"type": "number"},
          "center_y": {"type": "number"},
          "outer_radius": {"type": "number"},
          "outer_radius_unit": {"type": "string", "enum": ["map_units", "meters", "degrees"]},
          "inner_radius": {"type": "number"},
          "inner_radius_unit": {"type": "string", "enum": ["map_units", "meters", "degrees"]},
          "point_count": {"type": "integer"},
          "start_angle_degrees": {"type": "number"},
          "features": {
            "type": "array",
            "items": {"type": "object"},
            "minItems": 1
          },
          "name": {"type": "string"},
          "output_name": {"type": "string"},
          "spatial_reference_layer": {"type": "string", "x-geopilot-kind": "layer"},
          "wkid": {"type": "integer"},
          "output_workspace": {"type": "string"},
          "output_folder": {"type": "string"},
          "output_format": {"type": "string", "enum": ["gdb", "shp"]}
        },
        "additionalProperties": false
      },
      "context_requirements": {
        "requires_layers": false,
        "requires_output_location_when_unsaved": true

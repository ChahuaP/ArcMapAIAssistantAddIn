          "target_layer": {"type": "string", "x-geopilot-kind": "layer"},
          "coordinates": {
            "type": "array",
            "items": {"type": "object"},
            "minItems": 2
          },
          "features": {
            "type": "array",
            "items": {"type": "object"},

      "side_effects": "edits_data",
      "output_policy": {
        "writes_output": false,
        "edits_target_layer": true,
        "geometry_type": "Polygon"
      },
      "executor": "operations.edit_geometry_ops.append_regular_polygons",
      "examples": [
        {
          "user": "往 parcels 图层里添加一个正五边形",
          "arguments": {
            "target_layer": "parcels",
            "center_x": 500000,
            "center_y": 3500000,
            "radius": 100,
            "radius_unit": "meters",
            "sides": 5,
            "name": "new_pentagon"
          }
        }
      ]

{
  "pack": "edit_geometry",
  "operations": [
    {
      "id": "edit.create_point_features",
      "version": "1.0",
      "category": "edit_geometry",
      "summary": "根据坐标创建点要素图层。",
      "keywords": ["create point", "创建点", "坐标点", "点要素"],
      "model_card": "Use edit.create_point_features to create a new point feature class from explicit coordinates. Arguments: points array of {x,y,name optional}, output_name, spatial_reference_layer optional, wkid optional, output_workspace/output_folder/output_format optional. If spatial_reference_layer and wkid are omitted, ArcMap uses the active data frame spatial reference and fails when it is unknown.",
      "parameters_schema": {
        "type": "object",
        "required": ["points", "output_name"],
        "properties": {
          "points": {
            "type": "array",
            "items": {"type": "object"},
            "minItems": 1
          },
          "output_name": {"type": "string"},
          "spatial_reference_layer": {"type": "string", "x-geopilot-kind": "layer"},
          "wkid": {"type": "integer"},
          "output_workspace": {"type": "string"},
          "output_folder": {"type": "string"},
          "output_format": {"type": "string", "enum": ["gdb", "shp"]}
        },
        "additionalProperties": false
      },
      "context_requirements": {
        "requires_layers": false,
        "requires_output_location_when_unsaved": true
      },
      "side_effects": "writes_data",
      "output_policy": {
        "writes_output": true,
        "type": "feature_class",
        "geometry_type": "Point",
        "formats": ["gdb", "shp"],
        "default_format": "gdb",
        "workspace": "mxd_default_or_output_workspace_or_output_folder",
        "overwrite": false,
        "add_to_map": true
      },
      "executor": "operations.edit_geometry_ops.create_point_features",
      "examples": [
        {
          "user": "在 118.78,32.04 创建一个点",
          "arguments": {
            "points": [{"x": 118.78, "y": 32.04, "name": "point_1"}],
            "wkid": 4326,
            "output_name": "point_1"
          }
        }
      ]
    },
    {

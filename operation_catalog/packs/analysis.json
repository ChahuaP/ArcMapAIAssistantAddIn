    {
      "id": "analysis.append",
      "version": "1.0",
      "category": "analysis",
      "summary": "把输入图层追加到目标图层，直接修改目标数据。",
      "keywords": ["append", "追加", "追加到"],
      "model_card": "Use analysis.append to append input layers into an existing target layer. This directly edits target data and requires confirmation. Arguments: input_layers, target_layer, schema_type optional.",
      "parameters_schema": {
        "type": "object",
        "required": ["input_layers", "target_layer"],
        "properties": {
          "input_layers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "target_layer": {"type": "string"},
          "schema_type": {"type": "string", "enum": ["TEST", "NO_TEST"]}
        },
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true, "requires_confirmation": true},
      "side_effects": "edits_data",
      "output_policy": {"writes_output": false, "edits_original": true},
      "executor": "operations.analysis_ops.append",
      "examples": [{"user": "把 roads_new 追加到 roads", "arguments": {"input_layers": ["roads_new"], "target_layer": "roads", "schema_type": "NO_TEST"}}]

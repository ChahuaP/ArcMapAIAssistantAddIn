{
  "pack": "analysis",
  "version": "0.1.0",
  "operations": [
    {
      "id": "analysis.buffer",
      "version": "1.0",
      "category": "analysis",
      "summary": "对输入图层做缓冲区分析。",
      "keywords": ["buffer", "缓冲", "缓冲区", "距离"],
      "model_card": "Use analysis.buffer to create a buffer feature class. Arguments: input_layer, distance, output_name.",
      "parameters_schema": {
        "type": "object",
        "required": ["input_layer", "distance", "output_name"],
        "properties": {"input_layer": {"type": "string"}, "distance": {"type": "string"}, "output_name": {"type": "string"}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true, "requires_saved_mxd": true},
      "side_effects": "writes_data",
      "output_policy": {"writes_output": true, "workspace": "ArcMapAI_Output.gdb", "overwrite": false},
      "executor": "operations.analysis_ops.buffer",
      "examples": [{"user": "给 roads 做100米缓冲区", "arguments": {"input_layer": "roads", "distance": "100 Meters", "output_name": "roads_buffer_100m"}}]
    },
    {
      "id": "analysis.clip",
      "version": "1.0",
      "category": "analysis",
      "summary": "用裁剪图层裁剪输入图层。",
      "keywords": ["clip", "裁剪"],
      "model_card": "Use analysis.clip to clip input features by clip features. Arguments: input_layer, clip_layer, output_name.",
      "parameters_schema": {
        "type": "object",
        "required": ["input_layer", "clip_layer", "output_name"],
        "properties": {"input_layer": {"type": "string"}, "clip_layer": {"type": "string"}, "output_name": {"type": "string"}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true, "requires_saved_mxd": true},
      "side_effects": "writes_data",
      "output_policy": {"writes_output": true, "workspace": "ArcMapAI_Output.gdb", "overwrite": false},
      "executor": "operations.analysis_ops.clip",
      "examples": [{"user": "用 boundary 裁剪 roads", "arguments": {"input_layer": "roads", "clip_layer": "boundary", "output_name": "roads_clip"}}]
    },
    {
      "id": "analysis.intersect",
      "version": "1.0",
      "category": "analysis",
      "summary": "对多个图层做相交分析。",
      "keywords": ["intersect", "相交分析", "叠加"],
      "model_card": "Use analysis.intersect to intersect multiple input layers. Arguments: input_layers, output_name.",
      "parameters_schema": {
        "type": "object",
        "required": ["input_layers", "output_name"],
        "properties": {"input_layers": {"type": "array", "items": {"type": "string"}, "minItems": 2}, "output_name": {"type": "string"}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true, "requires_saved_mxd": true},
      "side_effects": "writes_data",
      "output_policy": {"writes_output": true, "workspace": "ArcMapAI_Output.gdb", "overwrite": false},
      "executor": "operations.analysis_ops.intersect",
      "examples": [{"user": "roads 和 boundary 做相交", "arguments": {"input_layers": ["roads", "boundary"], "output_name": "roads_boundary_intersect"}}]
    },
    {
      "id": "analysis.dissolve",
      "version": "1.0",
      "category": "analysis",
      "summary": "按字段融合要素。",
      "keywords": ["dissolve", "融合", "按字段合并"],
      "model_card": "Use analysis.dissolve to dissolve features. Arguments: input_layer, output_name, dissolve_fields optional.",
      "parameters_schema": {
        "type": "object",
        "required": ["input_layer", "output_name"],
        "properties": {"input_layer": {"type": "string"}, "output_name": {"type": "string"}, "dissolve_fields": {"type": "array", "items": {"type": "string"}}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true, "requires_saved_mxd": true},
      "side_effects": "writes_data",
      "output_policy": {"writes_output": true, "workspace": "ArcMapAI_Output.gdb", "overwrite": false},
      "executor": "operations.analysis_ops.dissolve",
      "examples": [{"user": "按 TYPE 融合 roads", "arguments": {"input_layer": "roads", "output_name": "roads_dissolve", "dissolve_fields": ["TYPE"]}}]
    },
    {
      "id": "analysis.project",
      "version": "1.0",
      "category": "analysis",
      "summary": "投影转换图层。",
      "keywords": ["project", "投影", "坐标转换"],
      "model_card": "Use analysis.project to project a layer. Arguments: input_layer, output_name, spatial_reference.",
      "parameters_schema": {
        "type": "object",
        "required": ["input_layer", "output_name", "spatial_reference"],
        "properties": {"input_layer": {"type": "string"}, "output_name": {"type": "string"}, "spatial_reference": {"type": "string"}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true, "requires_saved_mxd": true},
      "side_effects": "writes_data",
      "output_policy": {"writes_output": true, "workspace": "ArcMapAI_Output.gdb", "overwrite": false},
      "executor": "operations.analysis_ops.project",
      "examples": [{"user": "把 roads 投影到 WGS 1984", "arguments": {"input_layer": "roads", "output_name": "roads_wgs84", "spatial_reference": "WGS 1984"}}]
    },
    {
      "id": "analysis.spatial_join",
      "version": "1.0",
      "category": "analysis",
      "summary": "执行空间连接。",
      "keywords": ["spatial join", "空间连接"],
      "model_card": "Use analysis.spatial_join for ArcPy SpatialJoin_analysis. Arguments: target_layer, join_layer, output_name.",
      "parameters_schema": {
        "type": "object",
        "required": ["target_layer", "join_layer", "output_name"],
        "properties": {"target_layer": {"type": "string"}, "join_layer": {"type": "string"}, "output_name": {"type": "string"}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true, "requires_saved_mxd": true},
      "side_effects": "writes_data",
      "output_policy": {"writes_output": true, "workspace": "ArcMapAI_Output.gdb", "overwrite": false},
      "executor": "operations.analysis_ops.spatial_join",
      "examples": [{"user": "把 parcels 和 schools 做空间连接", "arguments": {"target_layer": "parcels", "join_layer": "schools", "output_name": "parcels_schools_join"}}]
    }
  ]
}

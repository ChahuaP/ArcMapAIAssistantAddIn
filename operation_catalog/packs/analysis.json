    {
      "id": "analysis.buffer",
      "version": "1.0",
      "category": "analysis",
      "summary": "对输入图层做缓冲区分析。",
      "keywords": ["buffer", "缓冲", "缓冲区", "距离"],
      "model_card": "Use analysis.buffer to create a buffer feature class. Arguments: input_layer, distance, output_name, output_workspace optional when MXD is unsaved. output_workspace may be a folder or a .gdb path.",
      "parameters_schema": {
        "type": "object",
        "required": ["input_layer", "distance", "output_name"],
        "properties": {"input_layer": {"type": "string"}, "distance": {"type": "string"}, "output_name": {"type": "string"}, "output_workspace": {"type": "string"}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true, "requires_output_location_when_unsaved": true},
      "side_effects": "writes_data",
      "output_policy": {"writes_output": true, "workspace": "mxd_default_or_output_workspace", "overwrite": false},
      "executor": "operations.analysis_ops.buffer",
      "examples": [{"user": "给 roads 做100米缓冲区", "arguments": {"input_layer": "roads", "distance": "100 Meters", "output_name": "roads_buffer_100m"}}]
    },

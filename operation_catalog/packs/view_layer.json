              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "outputs": {
          "kind": "map_state",
          "geometry": {
            "rule": "not_applicable",
            "value": "not_applicable"
          },
          "fields": {
            "effect": "not_applicable",
            "target": "not_applicable",
            "static_fields": [],
            "parameter_field": "not_applicable"
          },
          "spatial_reference": {
            "rule": "not_applicable",
            "input": "not_applicable"
          },
          "cardinality": {
            "rule": "fixed",
            "value": "one_snapshot"
          },
          "selection_state": "not_applicable",
          "map_publication": "published"

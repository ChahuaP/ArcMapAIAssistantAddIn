{
  "pack": "view_layer",
  "operations": [
    {
      "id": "layer.add_layer",
      "version": "1.0",
      "category": "view_layer",
      "summary": "向当前地图添加图层文件或数据集。",
      "keywords": ["add layer", "添加图层", "加载图层"],
      "model_card": "Use layer.add_layer to add a dataset or layer file to the active data frame. Arguments: path. When loading a TIFF with at least three bands, the runtime creates an RGB raster layer with bands 1;2;3 instead of ArcMap's default stretched single-band display.",
      "parameters_schema": {
        "type": "object",
        "required": ["path"],
        "properties": {"path": {"type": "string"}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": false},
      "side_effects": "changes_map",
      "output_policy": {"writes_output": false},
      "executor": "operations.layer_ops.add_layer",
      "examples": [{"user": "添加这个 shp", "arguments": {"path": "D:/data/roads.shp"}}]
    },
    {
      "id": "layer.set_visibility",
      "version": "1.0",
      "category": "view_layer",
      "summary": "设置图层显隐。",
      "keywords": ["visibility", "显示", "隐藏", "打开图层", "关闭图层"],
      "model_card": "Use layer.set_visibility to show or hide a layer. Arguments: layer, visible.",
      "parameters_schema": {
        "type": "object",
        "required": ["layer", "visible"],
        "properties": {"layer": {"type": "string"}, "visible": {"type": "boolean"}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true},
      "side_effects": "changes_map",
      "output_policy": {"writes_output": false},
      "executor": "operations.layer_ops.set_layer_visibility",
      "examples": [{"user": "隐藏 roads", "arguments": {"layer": "roads", "visible": false}}]
    },
    {
      "id": "layer.remove_layer",
      "version": "1.0",
      "category": "view_layer",
      "summary": "从当前地图移除一个图层，不删除源数据。",
      "keywords": ["remove layer", "删除图层", "移除图层"],
      "model_card": "Use layer.remove_layer to remove one layer from the current map without deleting source data. Arguments: layer.",
      "parameters_schema": {
        "type": "object",
        "required": ["layer"],
        "properties": {"layer": {"type": "string"}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true},
      "side_effects": "changes_map",
      "output_policy": {"writes_output": false},
      "executor": "operations.layer_ops.remove_layer",
      "examples": [{"user": "把 roads 图层从地图里移除", "arguments": {"layer": "roads"}}]
    },
    {
      "id": "layer.clear_layers",
      "version": "1.0",
      "category": "view_layer",
      "summary": "清空当前地图中的所有图层，不删除源数据。",
      "keywords": ["clear layers", "清空图层", "移除所有图层"],
      "model_card": "Use layer.clear_layers to remove all layers from the current map without deleting source data. No arguments.",
      "parameters_schema": {"type": "object", "properties": {}, "additionalProperties": false},
      "context_requirements": {"requires_layers": true},
      "side_effects": "changes_map",
      "output_policy": {"writes_output": false},
      "executor": "operations.layer_ops.clear_layers",
      "examples": [{"user": "清空所有图层", "arguments": {}}]
    },
    {
      "id": "layer.move_layer",
      "version": "1.0",
      "category": "view_layer",
      "summary": "调整图层顺序。",
      "keywords": ["move layer", "调整顺序", "图层置顶", "图层置底", "上移", "下移"],
      "model_card": "Use layer.move_layer to reorder layers. Arguments: layer, position, reference_layer optional. position must be TOP, BOTTOM, UP, DOWN, BEFORE, or AFTER. BEFORE/AFTER require reference_layer.",
      "parameters_schema": {
        "type": "object",
        "required": ["layer", "position"],
        "properties": {
          "layer": {"type": "string"},
          "position": {"type": "string", "enum": ["TOP", "BOTTOM", "UP", "DOWN", "BEFORE", "AFTER"]},
          "reference_layer": {"type": "string"}
        },
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true},
      "side_effects": "changes_map",
      "output_policy": {"writes_output": false},
      "executor": "operations.layer_ops.move_layer",
      "examples": [
        {"user": "把 roads 置顶", "arguments": {"layer": "roads", "position": "TOP"}},
        {"user": "把 roads 移到 boundary 上面", "arguments": {"layer": "roads", "position": "BEFORE", "reference_layer": "boundary"}}
      ]
    },
    {
      "id": "view.zoom_to_layer",
      "version": "1.0",
      "category": "view_layer",
      "summary": "缩放到图层范围。",
      "keywords": ["zoom", "缩放", "定位", "图层范围"],
      "model_card": "Use view.zoom_to_layer to zoom the active view to a layer. Arguments: layer.",
      "parameters_schema": {
        "type": "object",
        "required": ["layer"],
        "properties": {"layer": {"type": "string"}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true},
      "side_effects": "changes_map",
      "output_policy": {"writes_output": false},
      "executor": "operations.layer_ops.zoom_to_layer",
      "examples": [{"user": "缩放到 roads 图层", "arguments": {"layer": "roads"}}]
    },
    {
      "id": "view.zoom_to_selection",
      "version": "1.0",
      "category": "view_layer",
      "summary": "缩放到某图层的已选要素。",
      "keywords": ["zoom selection", "缩放到选择", "选中范围"],
      "model_card": "Use view.zoom_to_selection to zoom to selected features in one layer. Arguments: layer.",
      "parameters_schema": {
        "type": "object",
        "required": ["layer"],
        "properties": {"layer": {"type": "string"}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true},
      "side_effects": "changes_map",
      "output_policy": {"writes_output": false},
      "executor": "operations.layer_ops.zoom_to_selection",
      "examples": [{"user": "缩放到 roads 选中的要素", "arguments": {"layer": "roads"}}]
    },
    {
      "id": "view.refresh_view",
      "version": "1.0",
      "category": "view_layer",
      "summary": "刷新地图视图和目录。",
      "keywords": ["refresh", "刷新"],
      "model_card": "Use view.refresh_view to refresh active view and TOC. No arguments.",
      "parameters_schema": {"type": "object", "properties": {}, "additionalProperties": false},
      "context_requirements": {"requires_layers": false},
      "side_effects": "changes_map",
      "output_policy": {"writes_output": false},
      "executor": "operations.layer_ops.refresh_view",
      "examples": [{"user": "刷新地图", "arguments": {}}]
    }
  ]
}

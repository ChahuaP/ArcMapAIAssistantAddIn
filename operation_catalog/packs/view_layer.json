        "添加图层",
        "加载图层"
      ],
      "parameters_schema": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "context_requirements": {
        "requires_layers": false
      },
      "side_effects": "changes_map",
      "output_policy": {
        "writes_output": false
      },
      "executor": "operations.layer_ops.add_layer",
      "examples": [
        {
          "user": "添加这个 shp",
          "arguments": {
            "path": "D:/data/roads.shp"
          }
        }
      ],
      "capability_contract": {
        "inputs": [],
        "parameters_schema": {
          "type": "object",
          "required": [

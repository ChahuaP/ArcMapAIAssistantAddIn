      "model_card": "Use view.zoom_to_layer to zoom the active view to a layer. Arguments: layer.",
      "parameters_schema": {
        "type": "object",
        "required": ["layer"],
        "properties": {"layer": {"type": "string"}},
        "additionalProperties": false
      },
      "context_requirements": {"requires_layers": true},
      "side_effects": "changes_map",
      "output_policy": {"writes_output": false},
      "executor": "operations.layer_ops.zoom_to_layer",
      "examples": [{"user": "缩放到 roads 图层", "arguments": {"layer": "roads"}}]
    },
    {
      "id": "view.zoom_to_selection",
      "version": "1.0",
      "category": "view_layer",
      "summary": "缩放到某图层的已选要素。",

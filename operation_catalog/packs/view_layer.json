              "cardinality": {
                "ref": "outputs.cardinality"
              },
              "selection_state": {
                "ref": "outputs.selection_state"
              },
              "map_publication": {
                "ref": "outputs.map_publication"
              }
            }
          }
        ],
        "semantic_effects": [
          {
            "kind": "map_change",
            "result": {
              "output": true
            },
            "action": {
              "const": "add_layer"
            }

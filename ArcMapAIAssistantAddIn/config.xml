<?xml version="1.0" encoding="utf-8"?>
<ESRI.Configuration xmlns="http://schemas.esri.com/Desktop/AddIns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>ArcMap AI Assistant</Name>
  <AddInID>{7f42eea1-1f17-4cf4-9d4f-c0c8d28c0a23}</AddInID>
  <Description>ArcMap AI Assistant toolbar.</Description>
  <Version>1.1</Version>
  <Image />
  <Author>Codex</Author>
  <Company />
  <Date>05/19/2026</Date>
  <Targets>
    <Target name="Desktop" version="10.1" />
  </Targets>
  <AddIn language="PYTHON" library="ArcMapAIAssistant_addin.py" namespace="ArcMapAIAssistant_addin">
    <ArcMap>
      <Commands>
        <Button caption="助手"
                category="ArcMap AI Assistant"
                class="OpenAssistantButton"
                id="ArcMapAIAssistant_addin.openAssistantButton"
                message="Open ArcMap AI Assistant"
                tip="打开 ArcMap AI Assistant">
          <Help heading="ArcMap AI Assistant" />
        </Button>
        <Button caption="网关"
                category="ArcMap AI Assistant"
                class="StartGatewayButton"
                id="ArcMapAIAssistant_addin.startGatewayButton"
                message="Start local gateway"
                tip="启动本地网关">
          <Help heading="ArcMap AI Assistant" />
        </Button>
        <Button caption="同步"
                category="ArcMap AI Assistant"
                class="SyncContextButton"
                id="ArcMapAIAssistant_addin.syncContextButton"
                message="Sync current ArcMap context"
                tip="同步当前 ArcMap 上下文">
          <Help heading="ArcMap AI Assistant" />
        </Button>
        <Button caption="执行"
                category="ArcMap AI Assistant"
                class="ExecuteWorkflowButton"
                id="ArcMapAIAssistant_addin.executeWorkflowButton"
                message="Execute approved workflow"
                tip="执行已审批任务">
          <Help heading="ArcMap AI Assistant" />
        </Button>
      </Commands>
      <Extensions>
        <Extension caption="ArcMap AI Auto Sync"
                   class="AutoSyncExtension"
                   id="ArcMapAIAssistant_addin.autoSyncExtension"
                   autoLoad="true">
          <Help heading="ArcMap AI Assistant" />
        </Extension>
      </Extensions>
      <Toolbars>
        <Toolbar caption="ArcMap AI Assistant"
                 category="ArcMap AI Assistant"
                 id="ArcMapAIAssistant_addin.toolbar"
                 showInitially="true">
          <Items>
            <Button refID="ArcMapAIAssistant_addin.startGatewayButton" />
            <Button refID="ArcMapAIAssistant_addin.openAssistantButton" />
            <Button refID="ArcMapAIAssistant_addin.syncContextButton" />
            <Button refID="ArcMapAIAssistant_addin.executeWorkflowButton" />
          </Items>
        </Toolbar>
      </Toolbars>
      <Menus />
    </ArcMap>
  </AddIn>
</ESRI.Configuration>
